<view class="work-page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <text class="nav-title">上班鼓励器</text>
  </view>

  <view class="content">
    <view class="slogan-row">
      <view class="green-dot"></view>
      <text class="slogan">{{isDayOff ? '今日放假，安心休息' : '稳步守住此刻，日子会越来越宽裕'}}</text>
      <text class="clock">{{clock}}</text>
    </view>

    <view class="income-card {{isDayOff ? 'income-card--day-off' : ''}}">
      <block wx:if="{{isDayOff}}">
        <view class="income-top">
          <text class="muted">{{dayOffType}}</text>
          <text class="day-off-tag">休息日</text>
        </view>
        <view class="day-off-message">今日放假</view>
        <text class="day-off-caption">不打卡，不卷，安心休息</text>
      </block>
      <block wx:else>
        <view class="income-top">
          <text class="muted">今日</text>
          <text class="bonus {{bonusPulse ? 'bonus--pulse' : ''}}">+¥{{twoSecondAmount}}</text>
        </view>
        <view class="money-row">
          <text class="currency">¥</text>
          <text class="money">{{todayIncome}}</text>
        </view>
        <view class="live-row {{isWorking ? '' : 'live-row--paused'}}">
          <view class="live-dot {{isWorking ? '' : 'live-dot--paused'}}"></view>
          <text>{{workStatus}}</text>
        </view>
        <view class="progress-track">
          <view class="progress-fill" style="width: {{progressWidth}};"></view>
        </view>
        <text class="progress-text">今日进度 {{progressPercent}}%</text>
      </block>
    </view>

    <view class="config-card">
      <view class="config-header">
        <view>
          <text class="config-title">工资配置</text>
          <text class="config-caption">按每月 22 个工作日折算</text>
        </view>
        <text class="config-status {{isEditingConfig ? 'config-status--editing' : ''}}">{{configStatus}}</text>
      </view>

      <block wx:if="{{!isEditingConfig}}">
        <view class="config-summary">
          <view class="config-summary-row">
            <text class="config-label">月薪</text>
            <view class="salary-value-wrap">
              <view
                class="salary-visibility-toggle"
                aria-role="button"
                aria-label="{{isSalaryHidden ? '显示月薪' : '隐藏月薪'}}"
                catchtap="toggleSalaryVisibility"
              >
                <image
                  class="salary-eye-image"
                  src="{{isSalaryHidden ? '/images/salary-eye-closed.svg' : '/images/salary-eye-open.svg'}}"
                  mode="aspectFit"
                ></image>
              </view>
              <text wx:if="{{isSalaryHidden}}" class="config-value config-value--salary">****</text>
              <text wx:else class="config-value config-value--salary">¥{{monthlySalary}}</text>
            </view>
          </view>
          <view class="config-summary-row config-summary-row--time">
            <text class="config-label">上班时间</text>
            <view class="confirmed-times">
              <text>{{morningStart}} - {{morningEnd}}</text>
              <text>{{afternoonStart}} - {{afternoonEnd}}</text>
            </view>
          </view>
        </view>
        <button class="config-button config-button--primary" bindtap="beginConfigUpdate">更新配置</button>
      </block>

      <block wx:else>
        <view class="config-field">
          <text class="config-label">月薪</text>
          <view class="salary-input-wrap">
            <text>¥</text>
            <input
              class="salary-input"
              type="digit"
              maxlength="10"
              value="{{draftMonthlySalary}}"
              bindinput="onMonthlySalaryInput"
            />
          </view>
        </view>

        <view class="config-field config-field--times">
          <text class="config-label">上午</text>
          <view class="time-range">
            <picker mode="time" value="{{draftMorningStart}}" data-field="draftMorningStart" bindchange="onConfigTimeChange">
              <view class="time-picker">{{draftMorningStart}}</view>
            </picker>
            <text class="time-separator">至</text>
            <picker mode="time" value="{{draftMorningEnd}}" data-field="draftMorningEnd" bindchange="onConfigTimeChange">
              <view class="time-picker">{{draftMorningEnd}}</view>
            </picker>
          </view>
        </view>

        <view class="config-field config-field--times">
          <text class="config-label">下午</text>
          <view class="time-range">
            <picker mode="time" value="{{draftAfternoonStart}}" data-field="draftAfternoonStart" bindchange="onConfigTimeChange">
              <view class="time-picker">{{draftAfternoonStart}}</view>
            </picker>
            <text class="time-separator">至</text>
            <picker mode="time" value="{{draftAfternoonEnd}}" data-field="draftAfternoonEnd" bindchange="onConfigTimeChange">
              <view class="time-picker">{{draftAfternoonEnd}}</view>
            </picker>
          </view>
        </view>

        <view class="config-actions">
          <button class="config-button config-button--secondary" bindtap="cancelConfigUpdate">取消</button>
          <button class="config-button config-button--confirm" bindtap="confirmConfigUpdate">确认保存</button>
        </view>
      </block>
    </view>
  </view>
</view>
